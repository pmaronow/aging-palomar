public section

/-! Audit every retained proof/provider kernel constant, including
unused private proofs, private definitions and compiler-generated kernel
declarations. Every retained module is directly `import all`ed above:
private imports do not propagate across ordinary public imports.
Mathlib dependencies use Lean's exported transitive axiom caches.
The coverage assertions fail closed if the imported retained closure
contains a module without its own direct private import. The standalone
official Challenge intentionally contains placeholders and duplicates
the independent Solution statements; it is checked in a separate
environment and cannot enter this proof audit. The current
Audit module is a metaprogramming tool, not an imported proof module. -/

open Lean Elab Command

set_option maxHeartbeats 4000000

elab "#audit_spherical_aging" : command => do
  let env ← getEnv
  let projectRoots := #["SphericalAging", "Solution"]
  let vendorRoots := #["AbsorptionCutoff", "BrownianMotion", "FourPapersCommon",
    "KolmogorovExtension4", "StochasticCalculus"]
  let hasRoot := fun (n : Name) (roots : Array String) =>
    roots.any (fun root => n.toString == root || n.toString.startsWith (root ++ "."))
  let isProject := fun n => hasRoot n projectRoots
  let isVendor := fun n => hasRoot n vendorRoots
  let isRetained := fun n => isProject n || isVendor n
  let excludedChallenges := #["Challenge"]
  if env.allImportedModuleNames.any (fun n => hasRoot n #["Challenge"]) then
    throwError "Standalone Challenge placeholders must be audited in a separate environment"
  let retainedModules := (env.allImportedModuleNames.filter isRetained).qsort
    (fun a b => a.toString < b.toString)
  let privateModules := ((env.imports.filter (fun imp => imp.importAll && isRetained imp.module)).map
    (fun imp => imp.module)).qsort (fun a b => a.toString < b.toString)
  unless retainedModules == privateModules do
    let missing := retainedModules.filter (fun n => !privateModules.contains n)
    let extra := privateModules.filter (fun n => !retainedModules.contains n)
    throwError "Incomplete private-module audit coverage; missing direct import all: {missing}; extra: {extra}"
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut rows : Array Json := #[]
  let mut projectCount := 0
  let mut vendorCount := 0
  let mut privateCount := 0
  let constants := env.constants.toList.toArray.qsort (fun a b => a.1.toString < b.1.toString)
  for (name, info) in constants do
    let moduleName := match env.getModuleIdxFor? name with
      | some idx => env.allImportedModuleNames[idx.toNat]!
      | none => Name.anonymous
    if isRetained moduleName then
      unless privateModules.contains moduleName do
        throwError "Retained constant {name} lacks complete private module import: {moduleName}"
      let axioms ← collectAxioms name
      let unexpected := axioms.filter (fun a => !allowed.contains a)
      if !unexpected.isEmpty then
        throwError "Unexpected axioms for {name}: {unexpected}"
      rows := rows.push (Json.mkObj [
        ("declaration", toJson name.toString),
        ("module", toJson moduleName.toString),
        ("kind", toJson (match info with
          | .axiomInfo _ => "axiom"
          | .thmInfo _ => "theorem"
          | .defnInfo _ => "definition"
          | .opaqueInfo _ => "definition"
          | .inductInfo _ => "inductive"
          | .ctorInfo _ => "constructor"
          | _ => "generated")),
        ("axioms", toJson (axioms.map Name.toString))])
      if isProject moduleName then projectCount := projectCount + 1
      if isVendor moduleName then vendorCount := vendorCount + 1
      if name.toString.startsWith "_private." then privateCount := privateCount + 1
  logInfo (Json.mkObj [
    ("project", toJson "spherical-aging"),
    ("audit_scope", toJson "all-retained-proof-module-kernel-constants"),
    ("excluded_challenge_modules", toJson excludedChallenges),
    ("excluded_tool_modules", toJson #["Audit"]),
    ("private_module_coverage_complete", toJson true),
    ("private_import_modules", toJson (privateModules.map Name.toString)),
    ("private_import_count", toJson privateModules.size),
    ("audited_retained_modules", toJson (retainedModules.map Name.toString)),
    ("unexpected_axioms", toJson (0 : Nat)),
    ("audited_declarations", toJson rows.size),
    ("audited_project_declarations", toJson projectCount),
    ("audited_vendor_declarations", toJson vendorCount),
    ("audited_private_declarations", toJson privateCount),
    ("audited_project_modules", toJson ((retainedModules.filter isProject).map Name.toString)),
    ("audited_vendor_modules", toJson ((retainedModules.filter isVendor).map Name.toString)),
    ("declarations", Json.arr rows)]).compress

#audit_spherical_aging
